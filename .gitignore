# ==========================================
# API Failure Analyzer - Git Ignore
# ==========================================

# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.env.local

# Java & Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz

# Frontend & Node
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Diagnostics
*.log
logs/
backend/logs/
